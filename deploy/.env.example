# 镜像版本：普通部署固定版本，升级时修改此项。
NETOOLS_IMAGE=fairylandfuture/netools:0.2.0

# 必填：调用本服务的随机令牌，至少 16 个字符；与 Scamalytics Key 分开。
SERVICE_API_TOKEN=

# 默认仅本机访问；需要局域网/远程访问时可改为 0.0.0.0。
API_BIND_HOST=127.0.0.1
API_PORT=8000

# 以下均有默认值，首次部署通常无需修改。
CACHE_TTL_SECONDS=300
QUOTA_SAFETY_MARGIN=5
QUOTA_REFRESH_SECONDS=86400
MAX_PROBES_PER_MONTH=60
REDIS_MAXMEMORY=256mb
REDIS_PREFIX=netools
MAX_PENDING_LOOKUPS=512
HTTP_MAX_CONNECTIONS=256
LOOKUP_TIMEOUT_SECONDS=15
UPSTREAM_TIMEOUT_SECONDS=5
LEASE_SECONDS=30
KEY_WAIT_SECONDS=3
MAX_ATTEMPTS=3
BATCH_WORKERS=32

# ipregistry 的独立安全余量；凭证和初始额度填写在 config/ipregistry-keys.json。
IPREGISTRY_QUOTA_SAFETY_MARGIN=5

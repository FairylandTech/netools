NETOOLS_UID=
NETOOLS_GID=
SERVICE_API_TOKEN=
SCAMALYTICS_KEYS_FILE=config/scamalytics-keys.json
IPREGISTRY_KEYS_FILE=config/ipregistry-keys.json
IPREGISTRY_QUOTA_SAFETY_MARGIN=5
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_PREFIX=netools
CACHE_TTL_SECONDS=300
QUOTA_REFRESH_SECONDS=86400
QUOTA_SAFETY_MARGIN=5
MAX_PROBES_PER_MONTH=60
MAX_PENDING_LOOKUPS=512
HTTP_MAX_CONNECTIONS=256
LOOKUP_TIMEOUT_SECONDS=15
LEASE_SECONDS=30
UPSTREAM_TIMEOUT_SECONDS=5
KEY_WAIT_SECONDS=3
MAX_ATTEMPTS=3
BATCH_WORKERS=32
